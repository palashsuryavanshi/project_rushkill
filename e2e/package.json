{
  "name": "rushkill-e2e-tests",
  "version": "1.0.0",
  "description": "End-to-end tests for Rushkill WebSocket Relay Multiplayer",
  "type": "module",
  "scripts": {
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --testTimeout=30000",
    "test:watch": "node --experimental-vm-modules node_modules/jest/bin/jest.js --watch --testTimeout=30000"
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/ws": "^8.5.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.15",
    "typescript": "^5.4.0"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "roots": ["<rootDir>/../e2e"],
    "testMatch": ["**/*.test.ts"],
    "transform": {
      "^.+\\.ts$": "ts-jest"
    },
    "moduleNameMapping": {
      "^@/(.*)$": "<rootDir>/../src/$1"
    },
    "collectCoverageFrom": [
      "**/*.ts",
      "!**/node_modules/**",
      "!**/dist/**"
    ],
    "coverageDirectory": "coverage",
    "coverageReporters": ["text", "lcov", "html"]
  }
}