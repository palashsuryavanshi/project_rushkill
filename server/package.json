{
  "name": "rushkill-relay",
  "version": "1.0.0",
  "description": "WebSocket relay server for Project Rushkill multiplayer",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "start": "node dist/server.js",
    "dev": "tsx watch server.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --testTimeout=10000"
  },
  "dependencies": {
    "ws": "^8.18.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/node": "^20.11.0",
    "@types/ws": "^8.5.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.15",
    "tsx": "^4.7.0",
    "typescript": "^5.4.0"
  }
}
